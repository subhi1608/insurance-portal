{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "app.ts",
    "server.ts",
    "api/**/*.ts",
    "types/**/*.ts",
    "scripts/**/*.ts",
    "__tests__/**/*.ts",
    "vitest.config.ts"
  ]
}
